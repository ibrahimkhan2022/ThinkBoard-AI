# Copy to .env (never commit .env). Server-side only: nothing here is read by the client bundle.

# --- Provider selection -------------------------------------------------------
# mock (default, free), ollama (free, local hardware), meta (paid credits)
AI_PROVIDER=mock

# --- Ollama (optional, local; not implemented until Phase 4) ------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Meta Model API (paid; not implemented until Phase 4) ---------------------
META_MODEL=muse-spark-1.3
MODEL_API_KEY=
# Paid calls stay disabled unless this is exactly "true".
ENABLE_PAID_AI=false
# Application-level safety limits (our own gate, not provider-enforced limits).
MAX_META_CALLS_PER_SESSION=10
MAX_META_REQUESTS_PER_DAY=50
META_BUDGET_USD=150

# --- Server -------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Simulated latency for the mock provider so loading states are visible.
MOCK_DELAY_MS=500
# Extra comma-separated browser origins allowed by CORS (localhost is always allowed).
CORS_ORIGINS=

# --- Client (public; baked into the web bundle) --------------------------------
# EXPO_PUBLIC_API_URL=http://localhost:8787
