# Copy to .env (never commit .env). Server-side only: nothing here is read by the client bundle.

# --- Provider selection -------------------------------------------------------
# mock   (default, free, canned answers)
# ollama (free, runs on your computer; needs a vision model)
# meta   (paid credits; needs ENABLE_PAID_AI=true and MODEL_API_KEY)
AI_PROVIDER=mock

# --- Ollama (free, local) -------------------------------------------------------
# A VISION model is required, e.g.:  ollama pull gemma3:4b   (about 3 GB)
# Text-only models (llama3.1, codellama) cannot read the board and are refused.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=120000

# --- Meta Model API (paid) ------------------------------------------------------
# Prices (USD per million tokens, read 2026-10-29): muse-spark-1.3 input 1.25, output 4.25.
# A check is roughly 2,000 input tokens (image + prompt) and a few hundred output tokens,
# so about half a cent. Re-check https://dev.meta.ai/docs/pricing-rate-limits before relying on this.
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# Create a key at https://dev.meta.ai/api-keys/. Keep it ONLY here; never in client code or git.
MODEL_API_KEY=
# Paid calls stay disabled unless this is exactly "true".
ENABLE_PAID_AI=false
# The "-contributor" models are much cheaper, but Meta may train on the prompts, images and replies
# (student work). They are refused unless you set this to "true" on purpose.
META_ALLOW_TRAINING_USE=false
# Hard cap on output tokens per call. Hidden reasoning is billed as output, so this caps the worst case.
META_MAX_OUTPUT_TOKENS=1200
# Hidden reasoning effort: minimal | low | medium | high | off (omit the parameter). More costs more.
META_REASONING_EFFORT=low
META_TIMEOUT_MS=60000
# Application-level safety limits (our own gate with conservative estimates; NOT exact billing and
# NOT provider-enforced). Counters are kept in server/data/usage.json so a restart does not reset them.
# The daily limit is the real guard on a public demo: session ids are chosen by the browser.
MAX_META_CALLS_PER_SESSION=10
MAX_META_REQUESTS_PER_DAY=50
META_BUDGET_USD=150

# --- Server -------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Simulated latency for the mock provider so loading states are visible.
MOCK_DELAY_MS=500
# Extra comma-separated browser origins allowed by CORS (localhost is always allowed).
CORS_ORIGINS=

# --- Client (public; baked into the web bundle) --------------------------------
# EXPO_PUBLIC_API_URL=http://localhost:8787
